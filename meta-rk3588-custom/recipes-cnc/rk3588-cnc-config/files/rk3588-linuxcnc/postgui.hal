# postgui.hal — Post-GUI HAL wiring (runs after gmoccapy starts)

loadrt abs names=abs_spindle_feedback
addf abs_spindle_feedback servo-thread

net spindle-speed-limited  =>  abs_spindle_feedback.in
net spindle-abs  abs_spindle_feedback.out  =>  gmoccapy.spindle_feedback_bar

# --- Spindle at-speed: mux2 selects between sim and real VFD ---
# sel=0 → sim (spindle_sim.hal near_speed), sel=1 → real VFD (EK1814 din-2)
# Set sel=1 when real VFD is connected and spindle_sim.hal is removed
loadrt mux2 names=at_speed_mux
addf at_speed_mux servo-thread
net spindle-at-speed-sim   => at_speed_mux.in0
net spindle-at-speed-vfd   => at_speed_mux.in1
setp at_speed_mux.sel 0
net spindle-at-speed at_speed_mux.out => gmoccapy.spindle_at_speed_led

# Tool offset display
net tooloffset-x  gmoccapy.tooloffset-x  <=  motion.tooloffset.x
net tooloffset-z  gmoccapy.tooloffset-z  <=  motion.tooloffset.z

# Drive status to gmoccapy (optional indicators)
# net x-fault  lcec.master0.x-axis.srv-fault  =>  gmoccapy.<custom-pin>

component ssdc_homecomp "SSDC06 CiA402 drive-side hard-stop homemod";

description """
Custom HOMEMOD for MOONS'/AMP SSDC06-ECX-H (and similar CiA402) drives that
perform collision/hard-stop homing internally.

LinuxCNC does not command the search motion.  This module:
  1. Asserts joint.N.ext-home-start for the userspace drive home executor
  2. While waiting, sets motor_pos_fb = motor_pos_cmd to suppress following error
  3. On joint.N.ext-home-finished, syncs joint coordinates and marks homed

Requires HOMING_BASE pointing at a matching LinuxCNC src/emc/motion/homing.c.
Build with the accompanying build_ssdc_homecomp.sh (cross-compile via Yocto
linuxcnc workdir toolchain).

INI:
  [EMCMOT]
  HOMEMOD=ssdc_homecomp

HAL (per joint that uses drive-side home):
  setp joint.N.request-custom-homing 1
  net ... joint.N.ext-home-start => cia402_home.home-request
  net ... cia402_home.home-done  => joint.N.ext-home-finished
  net ... cia402_home.home-fault => joint.N.ext-home-fault
  net ... scale_fb.out           => joint.N.ext-actual-pos
""";

pin out bool is_module = 1;

license "GPL";
author "rk3588-cnc";
option homemod;
option extra_setup;
;;

#define STR(s) #s
#define XSTR(s) STR(s)

#define CHK(x)                          \
    do {                                \
        int _rv = (x);                  \
        if (0 != _rv) return _rv;       \
    } while (0)

/* Quoted path — unquoted paths containing "linux" break under cpp (linux→1).
 * build_ssdc_homecomp.sh rewrites this define. */
#ifndef HOMING_BASE
#define HOMING_BASE "/home/xuning/yocto-rk3588-core/build/tmp/work/cortexa76-cortexa55-crypto-poky-linux/linuxcnc/2.9.10+git/git/src/emc/motion/homing.c"
#endif

static char *home_parms;
RTAPI_MP_STRING(home_parms, "ssdc home parms");

EXTRA_SETUP() {
    (void)__comp_inst;
    (void)prefix;
    (void)extra_arg;
    if (!home_parms) home_parms = "ssdc";
    rtapi_print("ssdc_homecomp: HOMING_BASE=%s parms=%s\n",
                HOMING_BASE, home_parms);
    return 0;
}

//=====================================================================
#define CUSTOM_HOMEMODULE
#include HOMING_BASE

typedef enum {
    SSDC_HOME_IDLE = 0,
    SSDC_HOME_WAIT,
} ssdc_home_state_t;

typedef struct {
    hal_bool_t request_custom_homing; /* IN  */
    hal_bool_t is_custom_homing;      /* OUT */
    hal_bool_t ext_home_start;        /* OUT */
    hal_bool_t ext_home_finished;     /* IN  */
    hal_bool_t ext_home_fault;        /* IN  */
    hal_real_t ext_actual_pos;        /* IN  mm */
} ssdc_joint_pins_t;

static ssdc_joint_pins_t *spins = 0;
static ssdc_home_state_t *cstate = 0;
static double *freeze_motor_cmd = 0;
static int ssdc_njoints = 0;

static int ssdc_makepins(int id, int njoints)
{
    int jno;

    spins = hal_malloc(sizeof(*spins) * njoints);
    cstate = hal_malloc(sizeof(*cstate) * njoints);
    freeze_motor_cmd = hal_malloc(sizeof(*freeze_motor_cmd) * njoints);
    if (!spins || !cstate || !freeze_motor_cmd) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ssdc_homecomp: pin/state malloc failed\n");
        return -1;
    }
    ssdc_njoints = njoints;

    for (jno = 0; jno < njoints; jno++) {
        cstate[jno] = SSDC_HOME_IDLE;
        freeze_motor_cmd[jno] = 0.0;
        CHK(hal_pin_new_bool(id, HAL_IN, &spins[jno].request_custom_homing, 0,
                             "joint.%d.request-custom-homing", jno));
        CHK(hal_pin_new_bool(id, HAL_OUT, &spins[jno].is_custom_homing, 0,
                             "joint.%d.is-custom-homing", jno));
        CHK(hal_pin_new_bool(id, HAL_OUT, &spins[jno].ext_home_start, 0,
                             "joint.%d.ext-home-start", jno));
        CHK(hal_pin_new_bool(id, HAL_IN, &spins[jno].ext_home_finished, 0,
                             "joint.%d.ext-home-finished", jno));
        CHK(hal_pin_new_bool(id, HAL_IN, &spins[jno].ext_home_fault, 0,
                             "joint.%d.ext-home-fault", jno));
        CHK(hal_pin_new_real(id, HAL_IN, &spins[jno].ext_actual_pos, 0.0,
                             "joint.%d.ext-actual-pos", jno));
    }
    return 0;
}

static void ssdc_abort_joint(int jno)
{
    emcmot_joint_t *joint = &joints[jno];

    hal_set_bool(spins[jno].ext_home_start, 0);
    hal_set_bool(spins[jno].is_custom_homing, 0);
    cstate[jno] = SSDC_HOME_IDLE;
    H[jno].homing = 0;
    H[jno].homed = 0;
    H[jno].joint_in_sequence = 0;
    H[jno].index_enable = 0;
    joint->free_tp.enable = 0;
    H[jno].home_state = HOME_IDLE;
}

static void ssdc_finish_joint(int jno)
{
    emcmot_joint_t *joint = &joints[jno];
    double act = hal_get_real(spins[jno].ext_actual_pos);

    /* Drive has zeroed (or parked) at 'act' mm. Map joint HOME there. */
    joint->motor_pos_fb = act;
    joint->motor_pos_cmd = act;
    joint->motor_offset = act - joint->backlash_filt - H[jno].home;
    joint->pos_fb = H[jno].home;
    joint->pos_cmd = H[jno].home;
    joint->free_tp.curr_pos = H[jno].home;
    joint->free_tp.pos_cmd = H[jno].home;
    joint->free_tp.enable = 0;

    hal_set_bool(spins[jno].ext_home_start, 0);
    hal_set_bool(spins[jno].is_custom_homing, 0);
    cstate[jno] = SSDC_HOME_IDLE;

    H[jno].homing = 0;
    H[jno].homed = 1;
    H[jno].home_state = HOME_IDLE;
    H[jno].joint_in_sequence = 0;
    H[jno].index_enable = 0;

    rtapi_print_msg(RTAPI_MSG_INFO,
        "ssdc_homecomp: joint %d homed at actual=%.4f mm -> HOME=%.4f\n",
        jno, act, H[jno].home);
}

static int ssdc_1joint_state_machine(int jno)
{
    emcmot_joint_t *joint = &joints[jno];

    if (H[jno].home_state == HOME_IDLE && cstate[jno] == SSDC_HOME_IDLE) {
        return 0;
    }

    if (H[jno].home_state == HOME_START && cstate[jno] == SSDC_HOME_IDLE) {
        H[jno].homing = 1;
        H[jno].homed = 0;
        joint->free_tp.enable = 0;
        freeze_motor_cmd[jno] = joint->motor_pos_cmd;
        hal_set_bool(spins[jno].ext_home_start, 1);
        hal_set_bool(spins[jno].is_custom_homing, 1);
        cstate[jno] = SSDC_HOME_WAIT;
        rtapi_print_msg(RTAPI_MSG_INFO,
            "ssdc_homecomp: joint %d start ext home (freeze cmd=%.4f)\n",
            jno, freeze_motor_cmd[jno]);
    }

    if (cstate[jno] == SSDC_HOME_WAIT) {
        /* Keep free planner parked. FE suppression is done in HAL (mux)
         * because process_inputs() computes ferror before do_homing(). */
        joint->free_tp.enable = 0;
        hal_set_bool(spins[jno].is_custom_homing, 1);
        hal_set_bool(spins[jno].ext_home_start, 1);

        /* Drive finished successfully — prefer finish even if FE aborted us. */
        if (hal_get_bool(spins[jno].ext_home_finished)) {
            ssdc_finish_joint(jno);
            return 0;
        }
        if (hal_get_bool(spins[jno].ext_home_fault)) {
            rtapi_print_msg(RTAPI_MSG_ERR,
                "ssdc_homecomp: joint %d ext home fault\n", jno);
            ssdc_abort_joint(jno);
            return 0;
        }
        if (H[jno].home_state == HOME_ABORT) {
            /* Cancelled before drive finished (e.g. FE) — keep waiting for
             * drive result if start is still asserted; otherwise abort. */
            return 1;
        }
        return 1; /* busy */
    }

    if (H[jno].home_state == HOME_ABORT) {
        ssdc_abort_joint(jno);
        return 0;
    }

    return 0;
}

int homing_init(int id, double servo_period, int n_joints,
                int n_extrajoints, emcmot_joint_t *pjoints)
{
    CHK(base_homing_init(id, servo_period, n_joints, n_extrajoints, pjoints));
    CHK(ssdc_makepins(id, n_joints));
    return 0;
}

void read_homing_in_pins(int njoints)
{
    base_read_homing_in_pins(njoints);
}

void write_homing_out_pins(int njoints)
{
    int jno;
    base_write_homing_out_pins(njoints);
    if (!spins) return;
    /* Always service WAIT here: do_homing() is skipped when motion is
     * not FREE (e.g. disabled after FE), but pins must still finish/abort. */
    for (jno = 0; jno < njoints && jno < ssdc_njoints; jno++) {
        if (cstate[jno] == SSDC_HOME_WAIT) {
            if (hal_get_bool(spins[jno].ext_home_finished)) {
                ssdc_finish_joint(jno);
            } else if (hal_get_bool(spins[jno].ext_home_fault)) {
                ssdc_abort_joint(jno);
            } else {
                hal_set_bool(spins[jno].ext_home_start, 1);
                hal_set_bool(spins[jno].is_custom_homing, 1);
            }
        } else if (cstate[jno] == SSDC_HOME_IDLE) {
            hal_set_bool(spins[jno].is_custom_homing,
                         hal_get_bool(spins[jno].request_custom_homing));
        }
    }
}

bool do_homing(void)
{
    int jno, busy = 0;
    bool begin_all = base_get_allhomed();

    (void)base_do_homing;
    do_homing_sequence();

    for (jno = 0; jno < all_joints; jno++) {
        /* Keep servicing an in-progress custom home even after cancel. */
        if (spins && cstate[jno] == SSDC_HOME_WAIT) {
            busy += ssdc_1joint_state_machine(jno);
            continue;
        }
        if (!H[jno].joint_in_sequence) continue;
        if (!GET_JOINT_ACTIVE_FLAG(&joints[jno])) continue;
        if (spins && hal_get_bool(spins[jno].request_custom_homing)) {
            busy += ssdc_1joint_state_machine(jno);
        } else {
            busy += base_1joint_state_machine(jno);
        }
    }

    if (busy > 0) {
        homing_active = 1;
    } else if (sequence_state == HOME_SEQUENCE_IDLE) {
        homing_active = 0;
    }

    if (!begin_all && base_get_allhomed()) {
        homing_active = 0;
        return 1;
    }
    return 0;
}


bool get_homing_is_active(void)               { return base_get_homing_is_active(); }
bool get_index_enable(int jno)                { return base_get_index_enable(jno); }

void do_home_joint(int jno)                        { base_do_home_joint(jno); }

/* Override do_cancel_homing: base_do_cancel_homing only sets home_state =
 * HOME_ABORT and leaves H[jno].homing = 1.  The actual clearing of the
 * homing flag happens later when base_1joint_state_machine() runs the
 * HOME_ABORT case — but ssdc_homecomp bypasses that path for joints in
 * SSDC_HOME_WAIT (it keeps servicing the drive-side home itself).
 *
 * When an estop/disable fires during homing, emctaskmain immediately
 * follows do_cancel_homing() with emcJointUnhome(-2) -> set_all_unhomed(),
 * which checks get_homing() and refuses with "Cannot unhome while homing"
 * because the flag is still set.  Fix: clear the homing flag and abort the
 * drive-side home synchronously here so the subsequent unhome succeeds. */
void do_cancel_homing(int jno)
{
    if (jno < 0 || jno >= ssdc_njoints) {
        base_do_cancel_homing(jno);
        return;
    }
    /* Let the base cancel set HOME_ABORT for sequence/abort bookkeeping,
     * but it only does that while H[jno].homing is still 1, so call it
     * BEFORE clearing the flag. */
    base_do_cancel_homing(jno);
    /* Stop the drive-side home immediately. */
    hal_set_bool(spins[jno].ext_home_start, 0);
    hal_set_bool(spins[jno].is_custom_homing, 0);
    cstate[jno] = SSDC_HOME_IDLE;
    /* Clear the homing flag NOW so the set_all_unhomed() that estop
     * immediately follows up with doesn't reject with
     * "Cannot unhome while homing".  Also clear joint_in_sequence so
     * do_homing() doesn't keep re-entering the state machine after we
     * already cleaned up (do_homing() is skipped while motion is
     * disabled, so leaving it set would delay cleanup until re-enable). */
    H[jno].homing = 0;
    H[jno].homed = 0;
    H[jno].joint_in_sequence = 0;
    H[jno].index_enable = 0;
    H[jno].home_state = HOME_IDLE;
    joints[jno].free_tp.enable = 0;
}

